generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  phone                String                @id @db.VarChar(20)
  name                 String?               @db.VarChar(100)
  email                String?               @db.VarChar(100)
  city                 String?               @db.VarChar(50)
  country              String?               @db.VarChar(50)
  line1                String?               @db.VarChar(100)
  line2                String?               @db.VarChar(100)
  postalCode           String?               @map("postal_code") @db.VarChar(20)
  state                String?               @db.VarChar(50)
  updatedAt            DateTime?             @map("updated_at") @db.Timestamp(6)
  carts                carts[]
  chat_sessions        chat_sessions[]
  customer_preferences CustomerPreferences[]
  orders               Order[]

  @@map("customers")
}

model Order {
  orderNumber            Int             @id @map("order_number")
  orderNumberProvisional Int?            @map("order_number_provisional")
  amount                 Decimal?        @db.Decimal
  amountPaid             Decimal?        @map("amount_paid") @db.Decimal
  eventPayment           Decimal?        @map("event_payment") @db.Decimal
  createdAt              DateTime?       @map("created_at") @db.Timestamp(6)
  paymentMethod          String?         @map("payment_method") @db.VarChar(50)
  status                 String?         @db.VarChar(50)
  stripePaymentIntent    String?         @map("stripe_payment_intent") @db.VarChar(100)
  currency               String?         @db.VarChar(10)
  groupId                String?         @map("group_id") @db.VarChar(100)
  couponId               String?         @map("coupon_id")
  customerId             String?         @map("customer_id")
  session_id             String?
  cart_id                String?         @db.Uuid
  updated_at             DateTime?       @default(now()) @db.Timestamp(6)
  order_events           order_events[]
  orderLineItems         OrderLineItem[]
  carts                  carts?          @relation(fields: [cart_id], references: [id], map: "orders_cart_fk")
  customer               Customer?       @relation(fields: [customerId], references: [phone], onDelete: NoAction, onUpdate: NoAction)
  chat_sessions          chat_sessions?  @relation(fields: [session_id], references: [id], map: "orders_session_fk")
  payments               payments[]

  @@index([cart_id])
  @@index([session_id])
  @@map("orders")
}

model Product {
  id                String           @id @db.VarChar(100)
  name              String?          @db.VarChar(100)
  description       String?
  price             Decimal?         @db.Decimal
  category          String?          @db.VarChar(50)
  availableDays     String[]         @map("available_days")
  ingredients       String[]
  groups            String[]
  category_id       String?
  image_url         String?
  is_available      Boolean          @default(true)
  prep_time_minutes Int?             @default(15)
  cart_items        CartItem[]
  menu_categories   menu_categories? @relation(fields: [category_id], references: [id])

  @@map("products")
}

model OrderLineItem {
  id                  Int       @id @default(autoincrement())
  orderId             Int?      @map("order_id")
  productId           String?   @map("product_id") @db.VarChar(100)
  productName         String?   @map("product_name") @db.VarChar(100)
  price               Decimal?  @db.Decimal
  quantity            Int?
  date                DateTime? @db.Date
  groupId             String?   @map("group_id")
  preference          String?   @db.VarChar(100)
  specialInstructions String?   @map("special_instructions")
  taxRates            String?   @map("tax_rates")
  type                String?   @db.VarChar(50)
  order               Order?    @relation(fields: [orderId], references: [orderNumber], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_line_items")
}

model Coupon {
  id      String    @id @default(dbgenerated("nextval('coupons_id_seq'::regclass)")) @db.VarChar(100)
  name    String?   @db.VarChar(100)
  type    String?   @db.VarChar(50)
  value   Decimal?  @db.Decimal
  date    DateTime? @db.Date
  groupId String?   @map("group_id") @db.VarChar(100)

  @@map("coupons")
}

model chat_sessions {
  id          String     @id
  customer_id String
  title       String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  carts       carts[]
  customers   Customer   @relation(fields: [customer_id], references: [phone], onDelete: Cascade)
  messages    messages[]
  orders      Order[]

  @@index([customer_id, updated_at])
  @@map("chat_sessions")
}

model messages {
  id            String        @id
  session_id    String
  content       String
  sender        String
  message_type  String        @default("text")
  metadata      Json?
  created_at    DateTime      @default(now())
  chat_sessions chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@map("messages")
}

model Embedding {
  id        String                @id @db.Uuid
  ownerType String                @map("owner_type")
  ownerId   String                @map("owner_id")
  content   String
  embedding Unsupported("vector")
  metadata  Json?
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([ownerType, ownerId], map: "embeddings_owner_idx")
  @@index([embedding], map: "embeddings_embedding_ivfflat_cosine")
  @@map("embeddings")
}

model CustomerPreferences {
  id          String   @id @db.Uuid
  customer_id String
  key         String
  weight      Decimal  @default(0) @db.Decimal
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  customers   Customer @relation(fields: [customer_id], references: [phone], onDelete: Cascade, map: "customer_preferences_customer_fk")

  @@unique([customer_id, key], map: "uniq_pref")
  @@map("customer_preferences")
}

model CartItem {
  id         String   @id @db.Uuid
  cart_id    String   @db.Uuid
  productId  String   @map("product_id") @db.VarChar(100)
  title      String
  unit_price Decimal? @db.Decimal(10, 2)
  quantity   Int      @default(1)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_product_fk")

  @@index([cart_id], map: "cart_items_cart_idx")
  @@map("cart_items")
}

model carts {
  id            String        @id @db.Uuid
  session_id    String
  customer_id   String
  status        String        @default("OPEN")
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  updated_at    DateTime      @default(now()) @db.Timestamp(6)
  cart_items    CartItem[]
  customers     Customer      @relation(fields: [customer_id], references: [phone], onDelete: NoAction, onUpdate: NoAction, map: "carts_customer_fk")
  chat_sessions chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, map: "carts_session_fk")
  orders        Order[]

  @@index([session_id], map: "cart_by_session_idx")
}

model menu_categories {
  id            String    @id
  name          String
  description   String?
  display_order Int       @default(0)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  products      Product[]
}

model order_events {
  id         String   @id @db.Uuid
  order_id   Int
  type       String
  data       Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  orders     Order    @relation(fields: [order_id], references: [orderNumber], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, created_at], map: "order_events_order_idx")
}

model payments {
  id           String   @id @db.Uuid
  order_id     Int?
  provider     String   @default("stripe")
  provider_ref String?
  status       String   @default("PENDING")
  amount       Decimal? @db.Decimal(10, 2)
  currency     String?  @default("usd")
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  raw          Json?
  orders       Order?   @relation(fields: [order_id], references: [orderNumber], onUpdate: NoAction)

  @@index([order_id], map: "payments_order_idx")
  @@index([provider_ref])
}
