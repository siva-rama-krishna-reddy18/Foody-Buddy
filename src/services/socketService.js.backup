const chatService = require('./chatservice');

module.exports = (io) => {
    io.on('connection', (socket) => {
        console.log(`Client connected: ${socket.id}`);
        
        // Handle customer authentication
        socket.on('authenticate', async (data) => {
    socket.customerId = data.customerId;
    console.log(`Customer ${data.customerId} authenticated`);
    
    // Create a default session for this customer
    try {
        const session = await chatService.createSession(data.customerId, 'WebSocket Chat');
        socket.defaultSessionId = session.id;
        console.log(`Created default session ${session.id} for customer ${data.customerId}`);
    } catch (error) {
        console.log('Error creating default session:', error.message);
    }
});
        
        socket.on('join-session', async (data) => {
    try {
        const { sessionId } = data;
        const customerId = socket.customerId;
        
        if (!customerId) {
            socket.emit('error', { message: 'Customer ID required. Please authenticate first.' });
            return;
        }

        // Check if session exists, if not create it
        let session = await chatService.getSessionById(sessionId);
        if (!session) {
            // Create session if it doesn't exist
            session = await chatService.createSession(customerId, 'WebSocket Chat');
            console.log(`Created new session ${session.id} for customer ${customerId}`);
        }
        
        // Verify session belongs to customer
        if (session.customer_id !== customerId) {
            socket.emit('error', { message: 'Access denied to session' });
            return;
        }

        socket.join(`session_${sessionId}`);
        socket.currentSession = sessionId;
        
        console.log(`Customer ${customerId} joined session: ${sessionId}`);
        
        // Send session info and recent messages
        const messages = await chatService.getChatHistory(sessionId, 20);
        socket.emit('session-joined', {
            session,
            messages
        });
    } catch (error) {
        console.error('Join session error:', error);
        socket.emit('error', { message: 'Failed to join session' });
    }
});
        
        // Handle sending messages
        socket.on('send-message', async (data) => {
            try {
                const { content, messageType = 'text' } = data;
                const customerId = socket.customerId;
                const sessionId = socket.defaultSessionId;
                
                if (!customerId) {
                    socket.emit('error', { message: 'Customer ID required. Please authenticate first.' });
                    return;
                }
                
                if (!sessionId || !content) {
                    socket.emit('error', { message: 'Session ID and content are required' });
                    return;
                }
                
                // Verify session ownership
                const session = await chatService.getSessionById(sessionId);
                if (!session || session.customer_id !== customerId) {
                    socket.emit('error', { message: 'Session not found or access denied' });
                    return;
                }
                
                // Save user message
                const userMessage = await chatService.saveMessage(sessionId, content, 'customer', messageType);
                
                // Broadcast user message to session
                io.to(`session_${sessionId}`).emit('new-message', {
                    message: userMessage,
                    type: 'customer'
                });
                
                // Generate AI response (enhanced for FoodyBuddy)
                setTimeout(async () => {
                    try {
                        let aiResponse;
                        const lowerContent = content.toLowerCase();
                        
                        if (lowerContent.includes('hello') || lowerContent.includes('hi')) {
                            aiResponse = `Hello! I'm your FoodyBuddy AI assistant. I have access to 82 delicious food products and can help you with personalized recommendations. What are you craving today?`;
                        } else if (lowerContent.includes('pizza')) {
                            aiResponse = `Great choice! I can help you find the perfect pizza. We have several pizza options available. Would you like me to recommend based on your previous orders or show you our most popular pizzas?`;
                        } else if (lowerContent.includes('food') || lowerContent.includes('hungry')) {
                            aiResponse = `I'd love to help you find something delicious! I have access to 82 food products and can make personalized recommendations. What type of cuisine are you in the mood for?`;
                        } else if (lowerContent.includes('recommend')) {
                            aiResponse = `I'd be happy to recommend something perfect for you! Based on our 82 available food products, I can suggest items based on your preferences. What type of food are you looking for today?`;
                        } else if (lowerContent.includes('order')) {
                            aiResponse = `I can help you with ordering! Let me know what you'd like and I can guide you through our available options and help you place an order.`;
                        } else {
                            aiResponse = `Thanks for your message! I'm your FoodyBuddy AI assistant with access to 82 food products. I can help you with food recommendations, orders, and questions about our menu. How can I assist you today?`;
                        }
                        
                        const aiMessage = await chatService.saveMessage(sessionId, aiResponse, 'ai', 'text');
                        
                        io.to(`session_${sessionId}`).emit('new-message', {
                            message: aiMessage,
                            type: 'ai'
                        });
                    } catch (error) {
                        console.error('AI response error:', error);
                        socket.emit('error', { message: 'Failed to generate AI response' });
                    }
                }, 1000);
                
            } catch (error) {
                console.error('Send message error:', error);
                socket.emit('error', { message: 'Failed to send message' });
            }
        });
        
        // Handle typing indicators
        socket.on('typing-start', (data) => {
            const { sessionId } = data;
            socket.to(`session_${sessionId}`).emit('user-typing', {
                customerId: socket.customerId,
                isTyping: true
            });
        });
        
        socket.on('typing-stop', (data) => {
            const { sessionId } = data;
            socket.to(`session_${sessionId}`).emit('user-typing', {
                customerId: socket.customerId,
                isTyping: false
            });
        });
        
        // Handle leaving session
        socket.on('leave-session', (data) => {
            const { sessionId } = data;
            socket.leave(`session_${sessionId}`);
            socket.currentSession = null;
            console.log(`Customer ${socket.customerId} left session: ${sessionId}`);
        });
        
        // Handle disconnect
        socket.on('disconnect', () => {
            console.log(`Client disconnected: ${socket.id}`);
            
            // Notify session about user leaving if they were typing
            if (socket.currentSession) {
                socket.to(`session_${socket.currentSession}`).emit('user-typing', {
                    customerId: socket.customerId,
                    isTyping: false
                });
            }
        });
    });
    
    console.log('🔌 Socket.IO server initialized');
};